# Copy to .env (never commit .env) or export these variables.

# Endpoint, key and model.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna

# Wire format: "responses" = OpenAI Responses API (lets an OpenAI reasoning model reason and call tools);
#              "chat"      = chat completions, for any OpenAI-compatible server (Ollama, vLLM, LM Studio, ...).
LLM_API_STYLE=responses

# Optional. Reasoning effort for reasoning models (none / low / medium / high). Empty = the model's default.
LLM_REASONING_EFFORT=low
# Optional. Sampling temperature. Empty = the model's default (reasoning models usually do not accept one).
LLM_TEMPERATURE=

# Set by the grader. For local runs point CLAIMS_DB at the DuckDB file; TRACE_FILE is optional.
CLAIMS_DB=claims.duckdb
TRACE_FILE=trace.jsonl
